PROJECT_NAME=Jinbi Lesson Backend
PROJECT_VERSION=0.1.0
APP_ENV=development
DEBUG=true
DATABASE_ECHO=false

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DB=jinbi_backend_db
MYSQL_CHARSET=utf8mb4

# JWT_SECRET_KEY 用于签发登录 JWT，请在本地 .env 中改成足够长的随机字符串。
# 如果你已有 SECRET_KEY，也可以使用 SECRET_KEY，程序会兼容读取。
JWT_SECRET_KEY=please_change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 管理员端 AI 查询课时助手。API Key 只配置在后端，不要写入前端项目。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
